# .env.example
# FIX(18.05.2026): root env example is intentionally non-secret - Codex
#
# Runtime envs are split by owner:
# - backend/.env.example -> backend secrets, callbacks, payments, Telegram, AI
# - apps/web/.env.example -> Vite/browser-safe frontend values
# - packages/db/.env.example -> Prisma database URLs only
#
# Do not add shared secrets or browser envs here.

CLAUDE_SESSION_KEY=
