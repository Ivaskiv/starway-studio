# frontend/.env.example

# ============================================
# 🔧 РЕЖИМИ РОБОТИ
# ============================================

# ✅ ВАРІАНТ 1: Локальна розробка
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001

# ✅ ВАРІАНТ 2: Тестування з продакшн бекендом
VITE_API_URL=https://starway-backend.vercel.app/api
VITE_WS_URL=wss://starway-backend.vercel.app

# ✅ ВАРІАНТ 3: Автоматичне визначення (залиште порожнім)
# VITE_API_URL=
# VITE_WS_URL=
# (автоматично вибере localhost для dev, vercel для production)

# ============================================
# 📝 ІНСТРУКЦІЇ
# ============================================
# 
# Для локальної розробки:
# 1. Скопіюйте цей файл: cp .env.example .env
# 2. Розкоментуйте ВАРІАНТ 1
# 3. Запустіть локальний бекенд: cd backend && npm run dev
# 4. Запустіть фронтенд: cd frontend && npm run dev
#
# Для тестування з продакшн бекендом:
# 1. Розкоментуйте ВАРІАНТ 2
# 2. Запустіть тільки фронтенд: npm run dev
#
# Для деплою на Render/Vercel:
# 1. Використовуйте ВАРІАНТ 2 (продакшн URLs)
# 2. Або залиште ВАРІАНТ 3 порожнім для автоматичного визначення