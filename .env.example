NODE_ENV=development
API_NAME=Todo App
PORT=3001
APP_MODE=LM_ONLY

FRONTEND_URL=http://localhost:5173
MINIAPP_VERSION=20260324-1

# Prisma Accelerate / optional DB tooling
PRISMA_ACCELERATE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=your_prisma_accelerate_api_key

# Telegram
TELEGRAM_BOT_USERNAME=your_telegram_bot_username
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Payments
WAYFORPAY_MERCHANT=your_wayforpay_merchant
WAYFORPAY_SECRET=your_wayforpay_secret

# Auth
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change_me

# AI / encryption
OPENAI_API_KEY=your_openai_api_key
ENCRYPTION_KEY=your_64_char_hex_encryption_key
BOT_TOKEN_SECRET_KEY=your_64_char_hex_bot_token_secret_key
DEFAULT_AI_EXPERT_ID=1

# SendPulse
SENDPULSE_API_URL=https://api.sendpulse.com
SENDPULSE_API_TOKEN=your_sendpulse_api_token

# Neon
NEON_API_KEY=your_neon_api_key
NEON_PROJECT_ID=your_neon_project_id

# Content / media generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
HEYGEN_API_KEY=your_heygen_api_key
HEYGEN_AVATAR_IMAGE_PATH=./avatar.png

OUTPUT_DIR=./output
SCRIPTS_FILE=./reelsScripts.txt
FFMPEG_PATH=/usr/bin/ffmpeg

# Social publishing
INSTAGRAM_API_KEY=your_instagram_api_key
TIKTOK_API_KEY=your_tiktok_api_key
BUFFER_API_KEY=your_buffer_api_key

# Legacy / optional reference values
# DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."
# TELEGRAM_BOT_TOKEN=your_legacy_bot_token
# TELEGRAM_BOT_USERNAME=your_legacy_bot_username
# VITE_API_URL=https://starway-backend.vercel.app/api
# VITE_WS_URL=wss://starway-backend.vercel.app
