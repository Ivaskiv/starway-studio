{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./.cache/tsconfig.node",
    "tsBuildInfoFile": "./.cache/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
