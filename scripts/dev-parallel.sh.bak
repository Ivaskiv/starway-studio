#!/bin/bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_PORT=3001
FRONTEND_PORT=5173
NGROK_API_PORT=4040
BACKEND_HEALTH_URL="http://127.0.0.1:${BACKEND_PORT}/health/live"
BACKEND_READY_URL="http://127.0.0.1:${BACKEND_PORT}/health/ready"
BACKEND_TELEGRAM_HEALTH_URL="http://127.0.0.1:${BACKEND_PORT}/api/telegram/webhook/health"
FRONTEND_HEALTH_URL="http://127.0.0.1:${FRONTEND_PORT}"
NGROK_API_URL="http://127.0.0.1:${NGROK_API_PORT}/api/tunnels"
STARTUP_TIMEOUT_SECONDS=120
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/starway-dev-parallel.XXXXXX")"
BACKEND_LOG="${TMP_DIR}/backend.log"
FRONTEND_LOG="${TMP_DIR}/frontend.log"
NGROK_LOG="${TMP_DIR}/ngrok.log"

BACKEND_PID=""
FRONTEND_PID=""
NGROK_PID=""

info() {
  printf '[INFO] %s\n' "$1"
}

warn() {
  printf '[WARN] %s\n' "$1"
}

error() {
  printf '[ERROR] %s\n' "$1" >&2
}

success() {
  printf '[OK] %s\n' "$1"
}

print_section() {
  printf '\n=== %s ===\n' "$1"
}

pid_command() {
  ps -p "$1" -o command= 2>/dev/null | sed 's/^[[:space:]]*//'
}

pid_cwd() {
  lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
}

is_project_process() {
  local pid="$1"
  local cwd
  cwd="$(pid_cwd "$pid")"

  if [ -n "$cwd" ] && [[ "$cwd" == "$ROOT_DIR"* ]]; then
    return 0
  fi

  local cmd
  cmd="$(pid_command "$pid")"
  if [[ "$cmd" == *"$ROOT_DIR"* ]]; then
    return 0
  fi

  return 1
}

list_port_pids() {
  local port="$1"
  lsof -nP -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null | sort -u
}

stop_pid_gracefully() {
  local pid="$1"
  local label="$2"
  local step=0

  if ! kill -0 "$pid" 2>/dev/null; then
    return 0
  fi

  warn "Stopping ${label} (PID ${pid})"
  kill -TERM "$pid" 2>/dev/null || true

  while kill -0 "$pid" 2>/dev/null; do
    step=$((step + 1))
    if [ "$step" -ge 20 ]; then
      warn "${label} did not exit gracefully, sending SIGKILL"
      kill -KILL "$pid" 2>/dev/null || true
      break
    fi
    sleep 0.5
  done
}

assert_port_is_free_or_project_owned() {
  local port="$1"
  local label="$2"
  local pids
  pids="$(list_port_pids "$port" || true)"

  if [ -z "$pids" ]; then
    return 0
  fi

  local pid
  for pid in $pids; do
    local cmd
    cmd="$(pid_command "$pid")"
    if is_project_process "$pid"; then
      stop_pid_gracefully "$pid" "${label} project process"
    else
      error "Port ${port} is occupied by external process PID ${pid}: ${cmd}"
      error "Not terminating external process. Free the port manually and retry."
      exit 1
    fi
  done

  if [ -n "$(list_port_pids "$port" || true)" ]; then
    error "Port ${port} is still busy after cleanup"
    exit 1
  fi
}

stop_matching_project_processes() {
  local pattern="$1"
  local pids
  pids="$(pgrep -f "$pattern" 2>/dev/null || true)"

  if [ -z "$pids" ]; then
    return 0
  fi

  local pid
  for pid in $pids; do
    if [ "$pid" = "$$" ]; then
      continue
    fi
    if is_project_process "$pid"; then
      stop_pid_gracefully "$pid" "project process matching ${pattern}"
    fi
  done
}

http_ok() {
  local url="$1"
  curl -fsS --max-time 2 "$url" >/dev/null 2>&1
}

wait_for_http_ok() {
  local url="$1"
  local timeout="$2"
  local elapsed=0

  while [ "$elapsed" -lt "$timeout" ]; do
    if http_ok "$url"; then
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  return 1
}

read_ngrok_public_url() {
  curl -fsS --max-time 2 "$NGROK_API_URL" 2>/dev/null \
    | python3 -c 'import json,sys; data=json.load(sys.stdin); tunnels=data.get("tunnels") or []; urls=[t.get("public_url","") for t in tunnels if t.get("public_url","").startswith("https://")]; print(urls[0] if urls else "")' \
    2>/dev/null
}

wait_for_ngrok_public_url() {
  local timeout="$1"
  local elapsed=0

  while [ "$elapsed" -lt "$timeout" ]; do
    local url
    url="$(read_ngrok_public_url || true)"
    if [ -n "$url" ]; then
      printf '%s' "$url"
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done

  return 1
}

tail_failure_log() {
  local label="$1"
  local file="$2"
  if [ ! -f "$file" ]; then
    return 0
  fi

  print_section "${label} log tail"
  tail -n 40 "$file" | sed 's/^/  /'
}

cleanup() {
  local code=$?

  if [ -n "$NGROK_PID" ] && kill -0 "$NGROK_PID" 2>/dev/null; then
    kill -TERM "$NGROK_PID" 2>/dev/null || true
  fi
  if [ -n "$FRONTEND_PID" ] && kill -0 "$FRONTEND_PID" 2>/dev/null; then
    kill -TERM "$FRONTEND_PID" 2>/dev/null || true
  fi
  if [ -n "$BACKEND_PID" ] && kill -0 "$BACKEND_PID" 2>/dev/null; then
    kill -TERM "$BACKEND_PID" 2>/dev/null || true
  fi

  wait >/dev/null 2>&1 || true

  if [ "$code" -ne 0 ]; then
    warn "Logs preserved in ${TMP_DIR}"
  fi
}

trap cleanup EXIT INT TERM

print_status_table() {
  local backend_status="$1"
  local db_status="$2"
  local frontend_status="$3"
  local telegram_status="$4"
  local ngrok_status="$5"
  local ngrok_url="$6"

  print_section "Health"
  printf '%-12s %-8s %s\n' "Service" "Status" "Details"
  printf '%-12s %-8s %s\n' "backend" "$backend_status" "$BACKEND_HEALTH_URL"
  printf '%-12s %-8s %s\n' "database" "$db_status" "$BACKEND_READY_URL"
  printf '%-12s %-8s %s\n' "frontend" "$frontend_status" "$FRONTEND_HEALTH_URL"
  printf '%-12s %-8s %s\n' "telegram" "$telegram_status" "$BACKEND_TELEGRAM_HEALTH_URL"
  printf '%-12s %-8s %s\n' "ngrok" "$ngrok_status" "${ngrok_url:-$NGROK_API_URL}"
}

assert_runtime_dependencies() {
  local missing=0
  local dependency
  for dependency in pnpm curl python3 ngrok; do
    if ! command -v "$dependency" >/dev/null 2>&1; then
      error "Missing required dependency: ${dependency}"
      missing=1
    fi
  done

  if [ "$missing" -ne 0 ]; then
    exit 1
  fi
}

start_backend() {
  info "Starting backend on :${BACKEND_PORT}"
  (
    cd "$ROOT_DIR"
    exec pnpm -C backend dev
  ) >"$BACKEND_LOG" 2>&1 &
  BACKEND_PID=$!
}

start_frontend() {
  info "Starting frontend on :${FRONTEND_PORT}"
  (
    cd "$ROOT_DIR"
    exec pnpm -C apps/web dev
  ) >"$FRONTEND_LOG" 2>&1 &
  FRONTEND_PID=$!
}

start_ngrok() {
  info "Starting ngrok on :${NGROK_API_PORT}"
  (
    cd "$ROOT_DIR"
    exec ngrok http "$BACKEND_PORT" --log=stdout --log-format=json
  ) >"$NGROK_LOG" 2>&1 &
  NGROK_PID=$!
}

ensure_clean_project_processes() {
  print_section "Preflight"
  info "Checking project-owned processes and ports"

  stop_matching_project_processes "scripts/dev-parallel.sh"
  stop_matching_project_processes "pnpm -C backend dev"
  stop_matching_project_processes "pnpm --dir backend dev"
  stop_matching_project_processes "tsx watch --clear-screen=false"
  stop_matching_project_processes "pnpm -C apps/web dev"
  stop_matching_project_processes "pnpm --dir apps/web dev"
  stop_matching_project_processes "/vite"
  stop_matching_project_processes "ngrok http ${BACKEND_PORT}"

  assert_port_is_free_or_project_owned "$BACKEND_PORT" "backend"
  assert_port_is_free_or_project_owned "$FRONTEND_PORT" "frontend"
  assert_port_is_free_or_project_owned "$NGROK_API_PORT" "ngrok api"
}

validate_or_fail() {
  local ngrok_url="$1"
  local backend_status="✗"
  local db_status="✗"
  local frontend_status="✗"
  local telegram_status="✗"
  local ngrok_status="✗"

  if http_ok "$BACKEND_HEALTH_URL"; then
    backend_status="✓"
  fi
  if http_ok "$BACKEND_READY_URL"; then
    db_status="✓"
  fi
  if http_ok "$FRONTEND_HEALTH_URL"; then
    frontend_status="✓"
  fi
  if http_ok "$BACKEND_TELEGRAM_HEALTH_URL"; then
    telegram_status="✓"
  fi
  if [ -n "$ngrok_url" ]; then
    ngrok_status="✓"
  fi

  print_status_table "$backend_status" "$db_status" "$frontend_status" "$telegram_status" "$ngrok_status" "$ngrok_url"

  if [ "$backend_status" != "✓" ] || [ "$db_status" != "✓" ] || [ "$frontend_status" != "✓" ] || [ "$telegram_status" != "✓" ] || [ "$ngrok_status" != "✓" ]; then
    error "Startup validation failed"
    tail_failure_log "backend" "$BACKEND_LOG"
    tail_failure_log "frontend" "$FRONTEND_LOG"
    tail_failure_log "ngrok" "$NGROK_LOG"
    exit 1
  fi
}

monitor_processes() {
  while true; do
    local pid
    for pid in "$BACKEND_PID" "$FRONTEND_PID" "$NGROK_PID"; do
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        error "Dev service exited unexpectedly (PID ${pid})"
        tail_failure_log "backend" "$BACKEND_LOG"
        tail_failure_log "frontend" "$FRONTEND_LOG"
        tail_failure_log "ngrok" "$NGROK_LOG"
        exit 1
      fi
    done
    sleep 2
  done
}

main() {
  assert_runtime_dependencies
  ensure_clean_project_processes

  start_backend
  if ! wait_for_http_ok "$BACKEND_HEALTH_URL" "$STARTUP_TIMEOUT_SECONDS"; then
    error "Backend did not become healthy"
    tail_failure_log "backend" "$BACKEND_LOG"
    exit 1
  fi
  success "Backend is live"

  if ! wait_for_http_ok "$BACKEND_READY_URL" "$STARTUP_TIMEOUT_SECONDS"; then
    error "Database readiness check did not pass"
    tail_failure_log "backend" "$BACKEND_LOG"
    exit 1
  fi
  success "Database is ready"

  start_frontend
  if ! wait_for_http_ok "$FRONTEND_HEALTH_URL" 60; then
    error "Frontend did not become healthy"
    tail_failure_log "frontend" "$FRONTEND_LOG"
    exit 1
  fi
  success "Frontend is live"

  start_ngrok
  local ngrok_url
  ngrok_url="$(wait_for_ngrok_public_url 30 || true)"
  if [ -z "$ngrok_url" ]; then
    error "Ngrok tunnel did not become ready"
    tail_failure_log "ngrok" "$NGROK_LOG"
    exit 1
  fi
  success "Ngrok tunnel is live"

  validate_or_fail "$ngrok_url"

  print_section "Ready"
  printf 'Frontend  %s\n' "$FRONTEND_HEALTH_URL"
  printf 'Backend   %s\n' "http://127.0.0.1:${BACKEND_PORT}"
  printf 'Ngrok     %s\n' "$ngrok_url"
  printf 'Logs      %s\n' "$TMP_DIR"
  printf '\nPress Ctrl+C to stop all project-owned dev services.\n'

  monitor_processes
}

main "$@"
