{
  "redirects": [
    {
      "source": "/",
      "destination": "/focus",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/deliverables/(.*)",
      "destination": "/deliverables/$1"
    },
    {
      "source": "/((?!deliverables/).*)",
      "destination": "/index.html"
    }
  ]
}
