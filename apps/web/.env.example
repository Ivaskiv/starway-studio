# apps/web/.env.example
# Copy to apps/web/.env for local frontend development.
# FIX(18.05.2026): frontend env limited to Vite-exposed browser-safe values - Codex

# FRONTEND URLS
VITE_API_MODE=auto
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001
VITE_APP_URL_LOCAL=http://localhost:5173
VITE_APP_URL=https://your-vercel-app.vercel.app

# TELEGRAM
VITE_TELEGRAM_BOT_ID=

# PUBLIC OAUTH / CLIENT IDS
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_EXPERT_ID=

# FEATURE FLAGS
VITE_AUTH_BYPASS=

# DEV ONLY
# Use a real HTTPS tunnel only for local mobile/Telegram/HMR testing.
USE_NGROK=false
VITE_DEV_TUNNEL_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_HMR_HOST=
VITE_HMR_PROTOCOL=
VITE_HMR_CLIENT_PORT=
VITE_HMR_PORT=
