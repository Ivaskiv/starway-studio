{
  "name": "@starway/ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "main": "./dist/providers/index.js",
  "types": "./dist/providers/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./providers/models": {
      "types": "./dist/providers/models.d.ts",
      "import": "./dist/providers/models.js"
    },
    "./providers/routing": {
      "types": "./dist/providers/routing.d.ts",
      "import": "./dist/providers/routing.js"
    },
    "./providers/pricing": {
      "types": "./dist/providers/pricing.d.ts",
      "import": "./dist/providers/pricing.js"
    },
    "./providers/spendGuard": {
      "types": "./dist/providers/spendGuard.d.ts",
      "import": "./dist/providers/spendGuard.js"
    },
    "./providers/usageLedger": {
      "types": "./dist/providers/usageLedger.d.ts",
      "import": "./dist/providers/usageLedger.js"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic/index.d.ts",
      "import": "./dist/providers/anthropic/index.js"
    },
    "./providers/gemini": {
      "types": "./dist/providers/gemini/index.d.ts",
      "import": "./dist/providers/gemini/index.js"
    },
    "./providers/ollama": {
      "types": "./dist/providers/ollama/index.d.ts",
      "import": "./dist/providers/ollama/index.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai/index.d.ts",
      "import": "./dist/providers/openai/index.js"
    },
    "./providers/openrouter": {
      "types": "./dist/providers/openrouter/index.d.ts",
      "import": "./dist/providers/openrouter/index.js"
    },
    "./providers/registry": {
      "types": "./dist/providers/registry/index.d.ts",
      "import": "./dist/providers/registry/index.js"
    },
    "./prompts/salesPsychologist": {
      "types": "./dist/prompts/salesPsychologist.prompts.d.ts",
      "import": "./dist/prompts/salesPsychologist.prompts.js"
    },
    "./types/salesAssistant.types": {
      "types": "./dist/types/salesAssistant.types.d.ts",
      "import": "./dist/types/salesAssistant.types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/generative-ai": "^0.24.1",
    "@starway/db": "workspace:*",
    "openai": "^6.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7"
  }
}
