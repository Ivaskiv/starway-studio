// packages/frontend/tsconfig.json

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@frontend/*": ["./src/*"],
      "@starway/shared": ["../shared/src"],
      "@starway/shared/*": ["../shared/src/*"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}