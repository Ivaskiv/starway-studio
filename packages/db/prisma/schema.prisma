  userId    String
  day       Int
  analysis  String   @db.Text
  entries   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("trial_mirrors")
}

model MicroSupportItem {
  id          String   @id @default(uuid())
  userId      String
  action      String
  source      String?
  metadata    Json     @default("{}")
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
}

model CycleStreakMetric {
  id                 String   @id @default(uuid())
  userId             String   @unique
  daysStable         Int      @default(0)
  drainsCount        Int      @default(0)
  recoveryAfterDrain Int      @default(0)
  updatedAt          DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GamificationProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  bitMind   Int      @default(0)
  mindXP    Int      @default(0)
  neuroGems Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mindXP])
  @@index([level])
}

model Streak {
  id        String    @id @default(uuid())
  userId    String
  expertId  String
  startAt   DateTime  @default(now())
  endAt     DateTime?
  current   Int       @default(1)
  longest   Int       @default(1)
  totalDays Int       @default(1)
  lastAt    DateTime  @default(now())
  ruleKey   String    @default("daily_checkin")
  ruleVer   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  expert Expert @relation(fields: [expertId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleKey])
  @@index([userId, expertId])
}

