generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// CORE IDENTITY & ACCESS
// ═══════════════════════════════════════════════════════════

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expert {
  id               String    @id @default(uuid())
  email            String    @unique
  displayName      String
  telegramBotToken String?
  telegramBotName  String?
  timezone         String    @default("UTC")
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  users               User[]
  aiMentors           AIMentor[]
  products            Product[]
  funnels             Funnel[]
  subscriptions       Subscription[]
  paymentLogs         PaymentLog[]
  miniCourses         MiniCourse[]
  dailyEntries        DailyEntry[]
  microTasks          MicroTask[]
  streaks             Streak[]
  balanceWheelConfigs BalanceWheelConfig[]
  userBalanceEntries  UserBalanceEntry[]
  visionStatements    VisionStatement[]
  wheelAssessments    WheelAssessment[]
  mentorships         Mentorship[]
  mentorshipOffers    MentorshipOffer[]
  notifications       Notification[]
  reports             Report[]
  zoomSessions        ZoomSession[]

  userMentorStates  UserMentorState[]
  videoModules      VideoModule[]
  purchaseHistories PurchaseHistory[]

  @@index([isActive, deletedAt])
}

model User {
  id               String    @id @default(uuid())
  expertId         String?
  email            String    @unique
  name             String?
  firstName        String?
  lastName         String?
  // @deprecated — використовуй funnelState для lifecycle логіки
  currentState     UserState @default(NEW)
  // @deprecated — використовуй funnelState для lifecycle логіки
  currentStep      UserStep  @default(LINK_TELEGRAM)
  telegramUserId   String?   @unique
  telegramUserName String?   @unique
  telegramChatId   String?
  telegramLinkedAt DateTime?
  passwordHash     String?
  uiSettings       Json?
  settings         Json?

  lastLoginAt   DateTime? // додаємо поле для останнього логіну
  mentorSession AIMentorSession?

  // ========================
  // Onboarding fields
  // ========================
  // @deprecated — використовуй funnelState для lifecycle логіки
  onboardingStage     String? // Поточний етап онбордингу користувача
  onboardingStartedAt DateTime? // Коли стартував онбординг

  // ========================
  // Trial fields
  // ========================
  trialStartsAt DateTime? // Дата початку пробного періоду
  // @deprecated — використовуй funnelState для lifecycle логіки
  trialEndsAt   DateTime? // Дата закінчення пробного періоду

  role      Role      @default(USER)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expert     Expert?           @relation(fields: [expertId], references: [id])
  expertBots ExpertBotConfig[] @relation("ExpertBot")

  mentorConfig         MentorConfig?
  userMentors          UserAIMentor[]
  mentorStates         UserMentorState[]
  balanceEntries       UserBalanceEntry[]
  subscriptions        Subscription[]
  enrollments          Enrollment[]
  progress             UserProgress?
  funnels              Funnel[]
  ownedProducts        Product[]              @relation("ProductOwner")
  miniCourses          MiniCourse[]
  goalsSets            GoalsSet[]
  courseEnrollments    CourseEnrollment[]
  dailyEntries         DailyEntry[]
  mentorships          Mentorship[]
  mentorshipOffers     MentorshipOffer[]
  microTasks           MicroTask[]
  notifications        Notification[]
  notificationPreference NotificationPreference?
  reports              Report[]
  streaks              Streak[]
  telegramLinks        TelegramLink[]
  visionStatements     VisionStatement[]
  wheelAssessments     WheelAssessment[]
  zoomSessionAttendees ZoomSessionAttendee[]
  fivePointsEnrollment FivePointsEnrollment[]
  userMentorConfigs    UserMentorConfig[]
  paymentLogs          PaymentLog[]
  refreshTokens        RefreshToken[]
  purchaseHistories    PurchaseHistory[]
  dailyCycleLogs       DailyCycleLog[]
  microSupportItems    MicroSupportItem[]
  cycleStreakMetrics   CycleStreakMetric[]
  aiRecommendations    AIRecommendation[]
  cTAInteractions      CTAInteraction[]
  generationQuota      GenerationQuota?       @relation("UserGenerationQuota")
  reminders            Reminder[]
  weeklyReports        WeeklyReport[]
  mentorWeeklyProfiles MentorWeeklyProfile[]
  affiliateLinks       AffiliateLink[]
  expertProfile        ExpertProfile?         @relation("ExpertProfile")
  productSubscriptions ProductSubscription[]
  deepLinkTokens       DeepLinkToken[]

  assistantSessions   AssistantSession[]
  gamificationProfile GamificationProfile?
  assistantMemories   AssistantMemory[]

  aiConversations AIConversation[]
  aiMemory        AIMemory[]
  contentItems    ContentItem[]
  funnelLeads     FunnelLead[]
  events          Event[]

  userFunnelProgress     UserFunnelStageProgress[]
  userVideoProgress      UserVideoStageProgress[]
  userMiniCourseProgress UserMiniCourseStageProgress[]
  trialMirrors           TrialMirror[]

  @@unique([expertId, telegramUserId])
  @@index([expertId])
  @@index([telegramUserName])
  @@index([expertId, email])
  @@index([expertId, deletedAt])
  @@index([expertId, createdAt])
}

model ExpertProfile {
  id          String  @id @default(cuid())
  expertId    String  @unique
  displayName String
  bio         String? @db.Text
  avatarUrl   String?
  specialty   String?
  isPublic    Boolean @default(true)

  expert User @relation("ExpertProfile", fields: [expertId], references: [id], onDelete: Cascade)

  @@map("expert_profiles")
}

model UserMentorConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
// AI MENTOR SYSTEM
// ═══════════════════════════════════════════════════════════

model AIMentor {
  id          String  @id @default(uuid())
  expertId    String
  slug        String
  name        String
  description String?
  niche       String?
  isPublished Boolean @default(false)

  generatorConfig Json
  runtimeConfig   Json

  expert         Expert             @relation(fields: [expertId], references: [id])
  userMentors    UserAIMentor[]     @relation("AiMentorUsers")
  mentorStates   UserMentorState[]
  balanceEntries UserBalanceEntry[]

  createdAt DateTime @default(now())

  @@unique([expertId, slug])
}

model UserAIMentor {
  id         String @id @default(cuid())
  userId     String
  aiMentorId String

  state Json?
  meta  Json?

  currentStep       String
  context           Json      @default("{}")
  lastAnalyzedAt    DateTime?
  currentState      String?
  behaviorPattern   String?
  clarityLevel      String?
  stage             String?
  insight           String?
  blocker           String?
  realGoal          String?
  recommendedFocus  String?
  lastInteractionAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  aiMentor AIMentor @relation("AiMentorUsers", fields: [aiMentorId], references: [id])

  sessions AIMentorSession[]

  @@unique([userId, aiMentorId])
  @@index([userId, updatedAt])
  @@index([userId])
}

model BannerGeneration {
  id          String   @id @default(cuid())
  period      String
  segment     String
  headline    String
  subheadline String
  ctaText     String
  rawData     Json
  createdAt   DateTime @default(now())
}

// @deprecated — використовуй funnelState для lifecycle логіки
model AIMentorSession {
  id           String @id @default(cuid())
  userId       String @unique
  chatId       String
  userMentorId String
  state        String @default("idle")
  step         Int    @default(0)
  data         Json   @default("{}")

  createdAt DateTime  @default(now())
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  userMentor UserAIMentor      @relation(fields: [userMentorId], references: [id])
  messages   AIMentorMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_sessions")
}

model MentorQuestionSet {
  id   String @id @default(cuid())
  name String

  isActive  Boolean  @default(false)
  morning   Json     @default("[]")
  evening   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AIMentorMessage {
  id        String @id @default(cuid())
  sessionId String
  role      String
  content   String

  createdAt DateTime @default(now())

  session AIMentorSession @relation(fields: [sessionId], references: [id])
}

// @deprecated — використовуй funnelState для lifecycle логіки
model UserMentorState {
  id                String   @id @default(uuid())
  expertId          String
  userId            String
  aiMentorId        String
  currentStep       String
  context           Json     @default("{}")
  lastInteractionAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expert   Expert   @relation(fields: [expertId], references: [id])
  aiMentor AIMentor @relation(fields: [aiMentorId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, aiMentorId])
  @@unique([expertId, userId, aiMentorId])
  @@index([expertId, lastInteractionAt])
}

model MentorConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ═══════════════════════════════════════════════════════════
// PRODUCTS & MONETIZATION
// ═══════════════════════════════════════════════════════════

model Product {
  id           String  @id @default(uuid())
  expertId     String?
  ownerId      String
  code         String  @unique
  name         String
  description  String?
  priceCents   Int
  currency     String  @default("EUR")
  durationDays Int     @default(30)

  kind      ProductKind?
  features  Json         @default("{}") // { aiMentor: true, courses: true, zoom: true, liveChat: true, aiProducer: true }
  limits    Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  systemPrompt String?          @db.Text
  mentorConfig Json?
  botConfig    ExpertBotConfig?

  expert               Expert?               @relation(fields: [expertId], references: [id])
  owner                User                  @relation("ProductOwner", fields: [ownerId], references: [id])
  producerConfig       ProducerConfig?
  enrollments          Enrollment[]
  funnelLinks          FunnelProduct[]
  subscriptions        Subscription[]
  productSubscriptions ProductSubscription[]
  purchaseHistories    PurchaseHistory[]
  productScores        ProductScore[]
  marketplaceProducts  MarketplaceProduct[]
  affiliateLinks       AffiliateLink[]
  adCampaigns          AdCampaign[]
}

model ExpertBotConfig {
  id        String  @id @default(cuid())
  expertId  String?
  productId String? @unique

  botToken    String
  botUsername String
  botName     String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expert  User?    @relation("ExpertBot", fields: [expertId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("expert_bot_configs")
}

model Enrollment {
  id         String    @id @default(uuid())
  userId     String
  productId  String
  enrolledAt DateTime  @default(now())
  purchased  Boolean   @default(false)
  trialEnd   DateTime?
  expiresAt  DateTime?
  payRef     String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([expiresAt])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  expertId         String?
  productId        String?
  startsAt         DateTime?
  // @deprecated — використовуй funnelState для lifecycle логіки
  status           SubscriptionStatus
  planCode         String
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  autoRenew        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert  Expert?  @relation(fields: [expertId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([expertId, userId, status])
}

model ProductSubscription {
  id        String @id @default(cuid())
  userId    String
  productId String
  status    String @default("trial")

  trialEndsAt DateTime?
  expiresAt   DateTime?
  paidAt      DateTime?
  amount      Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_subscriptions")
}

enum CTAType {
  TELEGRAM
  MINI_APP
}

model AIRecommendation {
  id         String    @id @default(uuid())
  userId     String
  moduleId   String?
  moduleType StageType
  reason     String
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, moduleType])
}

model CTAInteraction {
  id        String   @id @default(uuid())
  userId    String
  type      CTAType
  moduleId  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum ReminderType {
  DAILY
  AI_CHECKIN
  FUNNEL
}

model Reminder {
  id             String       @id @default(uuid())
  userId         String
  type           ReminderType
  nextReminderAt DateTime
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model PaymentLog {
  id          String        @id @default(uuid())
  userId      String
  expertId    String
  amountCents Int
  currency    String        @default("EUR")
  status      PaymentStatus
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())

  expert Expert @relation(fields: [expertId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expertId, createdAt])
}

model PurchaseHistory {
  id           String   @id @default(uuid())
  userId       String
  expertId     String?
  productId    String?
  funnelId     String?
  miniCourseId String?
  amountCents  Int
  currency     String   @default("EUR")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert     Expert?     @relation(fields: [expertId], references: [id])
  product    Product?    @relation(fields: [productId], references: [id])
  funnel     Funnel?     @relation(fields: [funnelId], references: [id])
  miniCourse MiniCourse? @relation(fields: [miniCourseId], references: [id])

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// FUNNELS & COURSES
// ═══════════════════════════════════════════════════════════

model Funnel {
  id         String      @id @default(uuid())
  expertId   String?
  ownerId    String
  slug       String
  name       String
  code       String      @unique
  definition Json        @default("{}")
  blueprint  Json?
  type       FunnelType?
  status     String      @default("draft")
  isActive   Boolean     @default(true)
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  expert            Expert?           @relation(fields: [expertId], references: [id])
  owner             User              @relation(fields: [ownerId], references: [id])
  products          FunnelProduct[]
  stages            FunnelStage[]
  purchaseHistories PurchaseHistory[]

  @@unique([expertId, slug])
  @@index([expertId, isActive])
  @@index([expertId, deletedAt])
}

model FunnelProduct {
  id        String  @id @default(uuid())
  funnelId  String
  productId String
  funnel    Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([funnelId, productId])
}

model FunnelStage {
  id       String @id @default(cuid())
  funnelId String
  name     String

  funnel   Funnel                    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  progress UserFunnelStageProgress[]
}

model VideoModule {
  id         String       @id @default(uuid())
  expertId   String?
  title      String
  slug       String       @unique
  duration   Int?
  definition Json         @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  stages     VideoStage[]

  expert Expert? @relation(fields: [expertId], references: [id])
}

model VideoStage {
  id          String                   @id @default(cuid())
  videoId     String
  title       String
  order       Int                      @default(0)
  videoModule VideoModule              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  progress    UserVideoStageProgress[]

  @@index([videoId, order])
}

model UserFunnelStageProgress {
  id            String      @id @default(uuid())
  userId        String
  funnelStageId String
  status        StageStatus @default(PENDING)
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  stageIndex    Int         @default(0)
  updatedAt     DateTime    @default(now()) @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  funnelStage FunnelStage @relation(fields: [funnelStageId], references: [id])

  @@unique([userId, funnelStageId])
  @@index([userId])
}

model UserVideoStageProgress {
  id           String      @id @default(uuid())
  userId       String
  videoStageId String
  status       StageStatus @default(PENDING)
  startedAt    DateTime    @default(now())
  completedAt  DateTime?
  stageIndex   Int         @default(0)
  updatedAt    DateTime    @default(now()) @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoStage VideoStage @relation(fields: [videoStageId], references: [id])

  @@unique([userId, videoStageId])
  @@index([userId])
}

model UserMiniCourseStageProgress {
  id                String      @id @default(uuid())
  userId            String
  miniCourseStageId String
  status            StageStatus @default(PENDING)
  startedAt         DateTime    @default(now())
  completedAt       DateTime?
  stageIndex        Int         @default(0)
  updatedAt         DateTime    @default(now()) @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  miniCourseStage MiniCourseStage @relation(fields: [miniCourseStageId], references: [id])

  @@unique([userId, miniCourseStageId])
  @@index([userId])
}

model MiniCourse {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  description  String?
  definition   Json
  isActive     Boolean   @default(true)
  ownerId      String
  expertId     String?
  priceCents   Int       @default(0)
  durationDays Int       @default(30)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner             User              @relation(fields: [ownerId], references: [id])
  expert            Expert?           @relation(fields: [expertId], references: [id])
  stages            MiniCourseStage[]
  purchaseHistories PurchaseHistory[]

  @@index([ownerId])
  @@index([expertId])
}

model MiniCourseStage {
  id           String @id @default(cuid())
  miniCourseId String
  title        String
  order        Int    @default(0)

  miniCourse MiniCourse                    @relation(fields: [miniCourseId], references: [id], onDelete: Cascade)
  progress   UserMiniCourseStageProgress[]

  @@index([miniCourseId, order])
}

model Course {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courseEnrollments CourseEnrollment[]
}

model CourseEnrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model FivePointsEnrollment {
  id          String    @id @default(cuid())
  userId      String
  moduleId    String
  progress    Json      @default("{}")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module FivePointsModule @relation(fields: [moduleId], references: [id])

  @@index([userId, moduleId])
}

model FivePointsModule {
  id           String                 @id @default(uuid())
  code         String                 @unique
  title        String
  description  String?
  isActive     Boolean                @default(true)
  priceCents   Int                    @default(0)
  durationDays Int                    @default(0)
  definition   Json                   @default("{}")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  enrollments  FivePointsEnrollment[]
}

// ═══════════════════════════════════════════════════════════
// USER PROGRESS & ACTIVITIES
// ═══════════════════════════════════════════════════════════

model UserProgress {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalPoints     Int      @default(0)
  completedBlocks Int      @default(0)
  level           Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyEntry {
  id           String      @id @default(uuid())
  userId       String
  expertId     String
  date         DateTime
  content      Json        @default("{}")
  state        DailyState  @default(STABILITY)
  choice       DailyChoice @default(CONFIRMED_OLD)
  drain        DailyDrain?
  dayFact      String?
  aiAnalysis   String?
  microSupport Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  expert Expert @relation(fields: [expertId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([expertId, userId])
  @@index([userId, date])
}

model MicroTask {
  id          String    @id @default(uuid())
  userId      String
  expertId    String?
  title       String
  description String?
  sphere      String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert Expert? @relation(fields: [expertId], references: [id])

  @@index([userId])
  @@index([userId, isCompleted])
}

model DailyCycleLog {
  id        String      @id @default(uuid())
  userId    String
  date      DateTime
  state     DailyState  @default(STABILITY)
  choice    DailyChoice @default(CONFIRMED_OLD)
  drain     DailyDrain?
  dayFact   String?
  aiSummary String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model TrialMirror {
