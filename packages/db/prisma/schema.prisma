model Report {
  id          String   @id @default(uuid())
  expertId    String
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  content     Json     @default("{}")
  createdAt   DateTime @default(now())

  expert Expert @relation(fields: [expertId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expertId, userId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// ZOOM SESSIONS
// ═══════════════════════════════════════════════════════════

model ZoomSession {
  id                String     @id @default(uuid())
  expertId          String?
  scheduledAt       DateTime
  topic             String
  status            ZoomStatus @default(SCHEDULED)
  requests          Json       @default("[]")
  postSessionReport Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  expert    Expert?               @relation(fields: [expertId], references: [id])
  attendees ZoomSessionAttendee[]

  @@index([expertId, status])
  @@index([scheduledAt])
}

model ZoomSessionAttendee {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())

  session ZoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

