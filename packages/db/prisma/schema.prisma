  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert        Expert?            @relation(fields: [expertId], references: [id])

  @@index([expertId, userId, createdAt])
  @@index([expertId, userId, balanceConfigId, createdAt])
  @@index([expertId, aiMentorId, createdAt])
}

model VisionStatement {
  id            String   @id @default(uuid())
  userId        String
  expertId      String?
  statement     String
  questionnaire Json
  title         String?
  content       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expert Expert? @relation(fields: [expertId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expertId, userId])
}

model WheelAssessment {
  id            String   @id @default(uuid())
  userId        String
  expertId      String?
  statement     String?
  scores        Json
  weakestSphere String?
  focusSphere   String?
  analysis      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expert Expert? @relation(fields: [expertId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expertId, userId])
}

// ═══════════════════════════════════════════════════════════
// MENTORSHIP (Legacy Support)
// ═══════════════════════════════════════════════════════════

model Mentorship {
  id       String @id @default(uuid())
  expertId String
  userId   String

  status   MentorshipStatus
  startsAt DateTime
  endsAt   DateTime?
  pausedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expert Expert @relation(fields: [expertId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expertId, userId]) // не можна мати 2 активних контракти з тим самим експертом
  @@index([userId, status])
  @@index([expertId, status])
}

model MentorshipOffer {
  id           String           @id @default(uuid())
  expertId     String
  userId       String
  offerDetails Json             @default("{}")
  status       MentorshipStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  expert Expert @relation(fields: [expertId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expertId, userId])
}

// ═══════════════════════════════════════════════════════════
// COMMUNICATIONS & NOTIFICATIONS
// ═══════════════════════════════════════════════════════════

model Notification {
  id            String              @id @default(uuid())
  expertId      String?
  userId        String
  type          NotificationType?
  title         String?
  body          String?             @db.Text
  data          Json?               @default("{}")
  channel       NotificationChannel
  templateKey   String
  payload       Json                @default("{}")
  status        NotificationStatus  @default(PENDING)
  scheduledAt   DateTime?
  sentAt        DateTime?
  readAt        DateTime?
  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  expert Expert? @relation(fields: [expertId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expertId, status, scheduledAt])
  @@index([userId, type, status])
  @@index([templateKey, status])
}

model NotificationPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  telegramEnabled      Boolean  @default(true)
  emailEnabled         Boolean  @default(false)
  dailyMorningTime     Int      @default(540)
  dailyEveningTime     Int      @default(1260)
  timezone             String   @default("Europe/Kyiv")
  streakAlertsEnabled  Boolean  @default(true)
  weeklySummaryEnabled Boolean  @default(true)
  aiRemindersEnabled   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([timezone])
}

model NotificationJob {
  id        String                @id @default(uuid())
  type      NotificationType
  payload   Json                  @default("{}")
  runAt     DateTime
  status    NotificationJobStatus @default(PENDING)
  attempts  Int                   @default(0)
  lastError String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

// @deprecated — використовуй funnelState для lifecycle логіки
model TelegramLink {
  id        String   @id @default(uuid())
  userId    String
  code      String   @unique
  chatId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("(now() + '7 days'::interval)"))
  username  String?
  firstName String?
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId])
  @@index([userId])
}

model DeepLinkToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  action     String
  source     String
  target     String
  path       String?
  payload    Json?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([token, expiresAt])
  @@index([target, createdAt])
}

// ═══════════════════════════════════════════════════════════
