// Ai producer
// ═══════════════════════════════════════════════════════════

model ProducerConfig {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id])

  // Бренд
  niche          String
  targetAudience String  @db.Text
  utp            String  @db.Text
  tone           String  @default("inspiring")
  brandColors    String?

  // Активні модулі
  modules Json // { mentor, constructor, seo, targeting, funnel, reports }

  // Кеш останніх генерацій (щоб не генерувати щоразу)
  lastHeroGenAt   DateTime?
  lastSeoGenAt    DateTime?
  lastReportGenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyReport {
  id        String @id @default(cuid())
  productId String

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  weekStart DateTime
  weekEnd   DateTime

  overallScore   Int?
  completionRate Int?
  streakDays     Int?
  topInsights    Json?
  growthAreas    Json?
  struggleAreas  Json?
  wheelDelta     Json?
  summaryText    String?
  motivationText String?
  nextWeekFocus  String?
  nextWeekTasks  Json?
  pdfUrl         String?

  metrics      Json // { newUsers, conversions, revenue, ... }
  analysis     Json // { funnelHealth, bottleneck, ... }
  heroVariants Json // 3 hero варіанти
  adTexts      Json // 5 рекламних текстів

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  pdfSentAt DateTime?

  @@unique([userId, weekStart])
  @@index([productId, weekStart])
  @@index([userId, weekStart])
}

model MentorWeeklyProfile {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  weekStart         DateTime
  createdAt         DateTime  @default(now())
  behaviorPattern   String
  engagementRhythm  String
  mainPainThisWeek  String
  emotionalTone     String
  retentionRisk     Int
  retentionFactors  Json
  churnSignals      Json
  upsellReady       Boolean
  upsellProduct     String
  upsellTiming      String
  upsellReasoning   String
  offerShownAt      DateTime?
  nextMessageTone   String
  triggerForContact String
  recommendedOffer  String
  systemNotes       String

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model ContentVariant {
  id        String @id @default(cuid())
  productId String

  type    ContentType // HERO, AD_FACEBOOK, AD_INSTAGRAM, EMAIL_SUBJECT, SEO_TITLE
  variant String // A, B, C
  content Json // { headline, subline, cta } або { text, hashtags }

  // A/B результати
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)

  isActive    Boolean  @default(true)
  generatedAt DateTime @default(now())

  @@index([productId, type])
}

