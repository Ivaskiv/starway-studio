model GenerationQuota {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation("UserGenerationQuota", fields: [userId], references: [id])
  periodStart       DateTime
  used              Int      @default(0)
  baseLimit         Int      @default(33)
  purchased         Int      @default(0)
  totalTokensInput  Int      @default(0)
  totalTokensOutput Int      @default(0)
  totalCostUsd      Float    @default(0)
  updatedAt         DateTime @updatedAt
}

model GenerationLog {
  id           String         @id @default(cuid())
  userId       String
  productId    String?
  type         GenerationType
  model        String
  tokensInput  Int
  tokensOutput Int
  costUsd      Float
  taskPrompt   String?        @db.Text
  createdAt    DateTime       @default(now())

  @@index([userId, createdAt])
}

enum GenerationType {
  MORNING_SESSION
  EVENING_SESSION
  WHEEL_ANALYSIS
  WEEKLY_ANALYSIS
