generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expert {
  id                  String               @id @default(uuid())
  email               String               @unique
  displayName         String
  telegramBotToken    String?
  telegramBotName     String?
  timezone            String               @default("UTC")
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  aiMentors           AIMentor[]
  balanceWheelConfigs BalanceWheelConfig[]
  dailyEntries        DailyEntry[]
  funnels             Funnel[]
  mentorships         Mentorship[]
  mentorshipOffers    MentorshipOffer[]
  microTasks          MicroTask[]
  miniCourses         MiniCourse[]
  notifications       Notification[]
  paymentLogs         PaymentLog[]
  products            Product[]
  purchaseHistories   PurchaseHistory[]
  reports             Report[]
  streaks             Streak[]
  subscriptions       Subscription[]
  users               User[]
  userBalanceEntries  UserBalanceEntry[]
  userMentorStates    UserMentorState[]
  videoModules        VideoModule[]
  visionStatements    VisionStatement[]
  wheelAssessments    WheelAssessment[]
  zoomSessions        ZoomSession[]

  @@index([isActive, deletedAt])
}

model User {
  id                     String                        @id @default(uuid())
  expertId               String?
  email                  String                        @unique
  name                   String?
  firstName              String?
  lastName               String?
  telegramUserId         String?                       @unique
  telegramUserName       String?                       @unique
  telegramChatId         String?
  passwordHash           String?
  uiSettings             Json?
  settings               Json?
  lastLoginAt            DateTime?
  onboardingStage        String?
  onboardingStartedAt    DateTime?
  trialStartsAt          DateTime?
  trialEndsAt            DateTime?
  role                   Role                          @default(USER)
  deletedAt              DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  currentState           UserState                     @default(NEW)
  currentStep            UserStep                      @default(LINK_TELEGRAM)
  telegramLinkedAt       DateTime?
  funnelStage            UserFunnelStage               @default(LEAD)
  funnelUpdatedAt        DateTime?
  leadMagnetSentAt       DateTime?
  telegramEnabled        Boolean                       @default(true)
  aiConversations        AIConversation[]
  aiMemory               AIMemory[]
  aiRecommendations      AIRecommendation[]
  affiliateLinks         AffiliateLink[]
  annualStrategyMap      AnnualStrategyMap?
  assistantMemories      AssistantMemory[]
  assistantSessions      AssistantSession[]
  cTAInteractions        CTAInteraction[]
  contentItems           ContentItem[]
  courseEnrollments      CourseEnrollment[]
  cycleStreakMetrics     CycleStreakMetric?
  dailyCycleLogs         DailyCycleLog[]
  dailyEntries           DailyEntry[]
  deepLinkTokens         DeepLinkToken[]
  enrollments            Enrollment[]
  events                 Event[]
  fivePointsEnrollment   FivePointsEnrollment[]
  funnels                Funnel[]
  funnelLeads            FunnelLead[]
  gamificationProfile    GamificationProfile?
  generationQuota        GenerationQuota?              @relation("UserGenerationQuota")
  goalsSets              GoalsSet[]
  mentorConfig           MentorConfig?
  mentorWeeklyProfiles   MentorWeeklyProfile[]
  mentorships            Mentorship[]
  mentorshipOffers       MentorshipOffer[]
  microSupportItems      MicroSupportItem[]
  microTasks             MicroTask[]
  miniCourses            MiniCourse[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  paymentLogs            PaymentLog[]
  ownedProducts          Product[]                     @relation("ProductOwner")
  purchaseHistories      PurchaseHistory[]
  refreshTokens          RefreshToken[]
  reminders              Reminder[]
  reports                Report[]
  streaks                Streak[]
  subscriptions          Subscription[]
  telegramLinks          TelegramLink[]
  expert                 Expert?                       @relation(fields: [expertId], references: [id])
  userMentors            UserAIMentor[]
  balanceEntries         UserBalanceEntry[]
  userFunnelProgress     UserFunnelStageProgress[]
  userMemory             UserMemory?
  userMentorConfigs      UserMentorConfig?
  mentorStates           UserMentorState[]
  userMiniCourseProgress UserMiniCourseStageProgress[]
  progress               UserProgress?
  userVideoProgress      UserVideoStageProgress[]
  visionStatements       VisionStatement[]
  voiceEntries           VoiceEntry[]
  weeklyReports          WeeklyReport[]
  wheelAssessments       WheelAssessment[]
  zoomSessionAttendees   ZoomSessionAttendee[]
  expertBots             ExpertBotConfig[]             @relation("ExpertBot")
  expertProfile          ExpertProfile?                @relation("ExpertProfile")
  mentorSession          AIMentorSession?
  productAccesses        ProductAccess[]
  productSubscriptions   ProductSubscription[]
  trialMirrors           TrialMirror[]

  @@unique([expertId, telegramUserId])
  @@index([expertId])
  @@index([telegramUserName])
  @@index([expertId, email])
  @@index([expertId, deletedAt])
  @@index([expertId, createdAt])
  @@index([funnelStage])
}

model ExpertProfile {
  id          String  @id @default(cuid())
  expertId    String  @unique
  displayName String
  bio         String?
  avatarUrl   String?
  specialty   String?
  isPublic    Boolean @default(true)
  expert      User    @relation("ExpertProfile", fields: [expertId], references: [id], onDelete: Cascade)

  @@map("expert_profiles")
}

model UserMentorConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIMentor {
  id              String             @id @default(uuid())
  expertId        String
  slug            String
  name            String
  description     String?
  niche           String?
  isPublished     Boolean            @default(false)
  generatorConfig Json
  runtimeConfig   Json
  createdAt       DateTime           @default(now())
  expert          Expert             @relation(fields: [expertId], references: [id])
  userMentors     UserAIMentor[]     @relation("AiMentorUsers")
  balanceEntries  UserBalanceEntry[]
  mentorStates    UserMentorState[]

  @@unique([expertId, slug])
}

model UserAIMentor {
  id                String            @id @default(cuid())
  userId            String
  aiMentorId        String
  state             Json?
  meta              Json?
  currentStep       String
  context           Json              @default("{}")
  lastInteractionAt DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  behaviorPattern   String?
  blocker           String?
  clarityLevel      String?
  currentState      String?
  insight           String?
  lastAnalyzedAt    DateTime?
  realGoal          String?
  recommendedFocus  String?
  stage             String?
  aiMentor          AIMentor          @relation("AiMentorUsers", fields: [aiMentorId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  sessions          AIMentorSession[]

  @@unique([userId, aiMentorId])
  @@index([userId, updatedAt])
  @@index([userId])
}

model BannerGeneration {
  id          String   @id @default(cuid())
  period      String
  segment     String
  headline    String
  subheadline String
  ctaText     String
  rawData     Json
  createdAt   DateTime @default(now())
}

model MarketResearchCache {
  id          String   @id @default(cuid())
  type        String
  niche       String   @default("coaching_personal_dev")
  platform    String
  data        Json
  generatedAt DateTime @default(now())
  validUntil  DateTime
  promptUsed  String?
  model       String   @default("gpt-4o-mini")

  @@index([type, platform])
  @@index([validUntil])
}

model AIMentorSession {
  id           String            @id @default(cuid())
  userId       String            @unique
  chatId       String
  userMentorId String
  state        String            @default("idle")
  step         Int               @default(0)
  data         Json              @default("{}")
  createdAt    DateTime          @default(now())
  endedAt      DateTime?
  updatedAt    DateTime          @updatedAt
  messages     AIMentorMessage[]
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMentor   UserAIMentor      @relation(fields: [userMentorId], references: [id])

  @@map("mentor_sessions")
}

model MentorQuestionSet {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  morning   Json     @default("[]")
  evening   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AIMentorMessage {
  id        String          @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime        @default(now())
  session   AIMentorSession @relation(fields: [sessionId], references: [id])
}

model UserMentorState {
  id                String   @id @default(uuid())
  expertId          String
  userId            String
  aiMentorId        String
  currentStep       String
  context           Json     @default("{}")
  lastInteractionAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  aiMentor          AIMentor @relation(fields: [aiMentorId], references: [id])
  expert            Expert   @relation(fields: [expertId], references: [id])
  user              User     @relation(fields: [userId], references: [id])

  @@unique([userId, aiMentorId])
  @@unique([expertId, userId, aiMentorId])
  @@index([expertId, lastInteractionAt])
}

model MentorConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Product {
  id                   String                @id @default(uuid())
  expertId             String?
  ownerId              String
  code                 String                @unique
  name                 String
  description          String?
  priceCents           Int
  currency             String                @default("EUR")
  durationDays         Int                   @default(30)
  kind                 ProductKind?
  features             Json                  @default("{}")
  limits               Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  systemPrompt         String?
  mentorConfig         Json?
  adCampaigns          AdCampaign[]
  affiliateLinks       AffiliateLink[]
  enrollments          Enrollment[]
  funnelLinks          FunnelProduct[]
  marketplaceProducts  MarketplaceProduct?
  producerConfig       ProducerConfig?
  expert               Expert?               @relation(fields: [expertId], references: [id])
  owner                User                  @relation("ProductOwner", fields: [ownerId], references: [id])
  productScores        ProductScore?
  purchaseHistories    PurchaseHistory[]
  subscriptions        Subscription[]
  botConfig            ExpertBotConfig?
  productSubscriptions ProductSubscription[]
}

model ExpertBotConfig {
  id          String   @id @default(cuid())
  expertId    String?
  productId   String?  @unique
  botToken    String
  botUsername String
  botName     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expert      User?    @relation("ExpertBot", fields: [expertId], references: [id])
  product     Product? @relation(fields: [productId], references: [id])

  @@map("expert_bot_configs")
}

model Enrollment {
  id         String    @id @default(uuid())
  userId     String
  productId  String
  enrolledAt DateTime  @default(now())
  purchased  Boolean   @default(false)
  trialEnd   DateTime?
  expiresAt  DateTime?
  payRef     String?
  product    Product   @relation(fields: [productId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([expiresAt])
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String
  expertId         String?
  productId        String?
  startsAt         DateTime?
  status           SubscriptionStatus
  planCode         String
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  autoRenew        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  expert           Expert?            @relation(fields: [expertId], references: [id])
  product          Product?           @relation(fields: [productId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expertId, userId, status])
}

model ProductSubscription {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  status      String    @default("trial")
  trialEndsAt DateTime?
  expiresAt   DateTime?
  paidAt      DateTime?
  amount      Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_subscriptions")
}

model ProductAccess {
  id        String   @id @default(cuid())
  userId    String
  product   String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, product])
  @@index([product, role])
  @@map("product_access")
}

model AIRecommendation {
  id         String    @id @default(uuid())
  userId     String
  moduleId   String?
  moduleType StageType
  reason     String
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, moduleType])
}

model CTAInteraction {
  id        String   @id @default(uuid())
  userId    String
  type      CTAType
  moduleId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Reminder {
  id             String       @id @default(uuid())
  userId         String
  type           ReminderType
  nextReminderAt DateTime
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model PaymentLog {
  id          String        @id @default(uuid())
  userId      String
  expertId    String
  amountCents Int
  currency    String        @default("EUR")
  status      PaymentStatus
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())
  expert      Expert        @relation(fields: [expertId], references: [id])
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expertId, createdAt])
}

model PurchaseHistory {
  id           String      @id @default(uuid())
  userId       String
  expertId     String?
  productId    String?
  funnelId     String?
  miniCourseId String?
  amountCents  Int
  currency     String      @default("EUR")
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now())
  expert       Expert?     @relation(fields: [expertId], references: [id])
  funnel       Funnel?     @relation(fields: [funnelId], references: [id])
  miniCourse   MiniCourse? @relation(fields: [miniCourseId], references: [id])
  product      Product?    @relation(fields: [productId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Funnel {
  id                String            @id @default(uuid())
  expertId          String?
  ownerId           String
  slug              String
  name              String
  code              String            @unique
  definition        Json              @default("{}")
  blueprint         Json?
  type              FunnelType?
  status            String            @default("draft")
  isActive          Boolean           @default(true)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  expert            Expert?           @relation(fields: [expertId], references: [id])
  owner             User              @relation(fields: [ownerId], references: [id])
  products          FunnelProduct[]
  stages            FunnelStage[]
  purchaseHistories PurchaseHistory[]

  @@unique([expertId, slug])
  @@index([expertId, isActive])
  @@index([expertId, deletedAt])
}

model FunnelProduct {
  id        String  @id @default(uuid())
  funnelId  String
  productId String
  funnel    Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([funnelId, productId])
}

model FunnelStage {
  id       String                    @id @default(cuid())
  funnelId String
  name     String
  funnel   Funnel                    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  progress UserFunnelStageProgress[]
}

model VideoModule {
  id         String       @id @default(uuid())
  expertId   String?
  title      String
  slug       String       @unique
  duration   Int?
  definition Json         @default("{}")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  expert     Expert?      @relation(fields: [expertId], references: [id])
  stages     VideoStage[]
}

model VideoStage {
  id          String                   @id @default(cuid())
  videoId     String
  title       String
  order       Int                      @default(0)
  progress    UserVideoStageProgress[]
  videoModule VideoModule              @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, order])
}

model UserFunnelStageProgress {
  id            String      @id @default(uuid())
  userId        String
  funnelStageId String
  status        StageStatus @default(PENDING)
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  stageIndex    Int         @default(0)
  updatedAt     DateTime    @default(now()) @updatedAt
  funnelStage   FunnelStage @relation(fields: [funnelStageId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, funnelStageId])
  @@index([userId])
}

model UserVideoStageProgress {
  id           String      @id @default(uuid())
  userId       String
  videoStageId String
  status       StageStatus @default(PENDING)
  startedAt    DateTime    @default(now())
  completedAt  DateTime?
  stageIndex   Int         @default(0)
  updatedAt    DateTime    @default(now()) @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoStage   VideoStage  @relation(fields: [videoStageId], references: [id])

  @@unique([userId, videoStageId])
  @@index([userId])
}

model UserMiniCourseStageProgress {
  id                String          @id @default(uuid())
  userId            String
  miniCourseStageId String
  status            StageStatus     @default(PENDING)
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  stageIndex        Int             @default(0)
  updatedAt         DateTime        @default(now()) @updatedAt
  miniCourseStage   MiniCourseStage @relation(fields: [miniCourseStageId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, miniCourseStageId])
  @@index([userId])
}

model MiniCourse {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  description       String?
  definition        Json
  isActive          Boolean           @default(true)
  ownerId           String
  expertId          String?
  priceCents        Int               @default(0)
  durationDays      Int               @default(30)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  expert            Expert?           @relation(fields: [expertId], references: [id])
  owner             User              @relation(fields: [ownerId], references: [id])
  stages            MiniCourseStage[]
  purchaseHistories PurchaseHistory[]

  @@index([ownerId])
  @@index([expertId])
}

model MiniCourseStage {
  id           String                        @id @default(cuid())
  miniCourseId String
  title        String
  order        Int                           @default(0)
  miniCourse   MiniCourse                    @relation(fields: [miniCourseId], references: [id], onDelete: Cascade)
  progress     UserMiniCourseStageProgress[]

  @@index([miniCourseId, order])
}

model Course {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courseEnrollments CourseEnrollment[]
}

model CourseEnrollment {
  id          String    @id @default(uuid())
  userId      String
  courseId    String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model FivePointsEnrollment {
  id          String           @id @default(cuid())
  userId      String
  moduleId    String
  progress    Json             @default("{}")
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  module      FivePointsModule @relation(fields: [moduleId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId])
}

model FivePointsModule {
  id           String                 @id @default(uuid())
  code         String                 @unique
  title        String
  description  String?
  isActive     Boolean                @default(true)
  priceCents   Int                    @default(0)
  durationDays Int                    @default(0)
  definition   Json                   @default("{}")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  enrollments  FivePointsEnrollment[]
}

model UserProgress {
  id              String   @id @default(uuid())
  userId          String   @unique
  totalPoints     Int      @default(0)
  completedBlocks Int      @default(0)
  level           Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyEntry {
  id              String      @id @default(uuid())
  userId          String
  expertId        String
  date            DateTime
  content         Json        @default("{}")
  state           DailyState  @default(STABILITY)
  choice          DailyChoice @default(CONFIRMED_OLD)
  drain           DailyDrain?
  dayFact         String?
  aiAnalysis      String?
  microSupport    Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  canCatchUpUntil DateTime?
  lateCompletedAt DateTime?
  status          DayStatus   @default(PENDING)
  expert          Expert      @relation(fields: [expertId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([expertId, userId])
  @@index([userId, date])
  @@index([userId, status])
}

model MicroTask {
  id                   String    @id @default(uuid())
  userId               String
  expertId             String?
  title                String
  description          String?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  dueAt                DateTime?
  isCompleted          Boolean   @default(false)
  sphere               String?
  why                  String?
  steps                Json?
  stepsCompleted       Json?
  priority             String    @default("medium")
  status               String    @default("active")
  xpReward             Int       @default(20)
  daysToComplete       Int       @default(1)
  generatedFromEntryId String?
  aiContext            String?
  expert               Expert?   @relation(fields: [expertId], references: [id])
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isCompleted])
  @@index([userId, status])
  @@index([dueAt])
}

model DailyCycleLog {
  id        String      @id @default(uuid())
  userId    String
  date      DateTime
  state     DailyState  @default(STABILITY)
  choice    DailyChoice @default(CONFIRMED_OLD)
  drain     DailyDrain?
  dayFact   String?
  aiSummary String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model TrialMirror {
