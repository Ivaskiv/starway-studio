{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist", 
     "jsx": "react-jsx", 
    "types": ["react", "node"]
  },
  "include": ["src/**/*"]
}
