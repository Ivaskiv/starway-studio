{
  "name": "starway-backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "pnpm --filter @starway/db run build && tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @starway/db run build && tsc --noEmit",
    "vercel-build": "pnpm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "@starway/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "fastify": "^5.7.4",
    "get-stream": "^9.0.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.25.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@prisma/client": "5.22.0",
    "@telegraf/types": "^9.2.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "4.19.8",
    "@types/get-stream": "^3.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.5",
    "@types/uuid": "^11.0.0",
    "prisma": "5.22.0",
    "telegraf": "^4.16.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "winston": "^3.19.0"
  }
}
