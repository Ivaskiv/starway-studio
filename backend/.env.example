# backend/.env.example
# Copy to backend/.env and fill real values locally.
# FIX(18.05.2026): centralized payment callback envs - Codex

# DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&connection_limit=3&pool_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PRISMA_ACCELERATE_URL=
NEON_API_KEY=
NEON_PROJECT_ID=

# BACKEND URLS
# Local payment/webhook testing: HTTPS ngrok/Cloudflare tunnel to backend.
# Production: Render API origin, for example https://starway-api.onrender.com.
PUBLIC_API_URL=https://your-backend-tunnel-or-render-origin.example.com
INTERNAL_API_URL=http://127.0.0.1:3001/api
TELEGRAM_WEBHOOK_URL=

# FRONTEND URLS
# Local browser dev can use localhost. Telegram web_app URLs must be public HTTPS.
FRONTEND_URL=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
TELEGRAM_WEBAPP_BASE_URL=https://your-frontend-tunnel.example.com
MINIAPP_VERSION=dev

# WAYFORPAY
WAYFORPAY_MERCHANT=
WAYFORPAY_SECRET=
WAYFORPAY_CALLBACK_URL=https://your-backend-tunnel-or-render-origin.example.com/api/subscriptions/payments/wayforpay/callback
BILLING_CALLBACK_URL=https://your-backend-tunnel-or-render-origin.example.com/api/billing/webhook
WAYFORPAY_FOCUS_BOT_1M_URL=
WAYFORPAY_FOCUS_BOT_3M_URL=
WAYFORPAY_FOCUS_LANDING_URL=

# TELEGRAM
START_TELEGRAM_BOT=true
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
BOT_TOKEN_SECRET_KEY=
# Посилання запрошення в закритий Telegram канал ФОКУС (fallback, якщо FOCUS_TELEGRAM_CHANNEL_ID не задано)
FOCUS_TELEGRAM_CHANNEL_INVITE_LINK=https://t.me/your_private_focus_channel
# Числовий ID каналу ФОКУС — для генерації одноразових invite links (отримати: @userinfobot у каналі)
# Формат: -1001234567890
FOCUS_TELEGRAM_CHANNEL_ID=
NEXT_ZOOM_AT=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# AI
# ==============================================================================
# AI MODELS & PROVIDERS CONFIGURATION (STARWAY ENGINE v4.0)
# ==============================================================================
# 1. OpenAI (GPT-4o, Квоти та Аналітика)
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o"
OPENAI_WHEEL_MODEL="gpt-4o-mini"
ADMIN_PROMPT_ANALYSIS_MODEL="gpt-4o"

# 2. Anthropic (Claude 3.5 Sonnet — Ядро психолінгвістики та анти-AI текстів)
ANTHROPIC_API_KEY="sk-ant-api03-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20240620"

# 3. Google AI Studio (Gemini 1.5 Pro/Flash — Фільтр інфошуму та безкоштовний аудит)
# Безкоштовні ліміти (Free Tier) отримуються на ai.google.dev без прив'язки картки
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-pro"

# FEATURE FLAGS
DISABLE_SCHEDULERS=
DISABLE_NOTIFICATION_WORKERS=
DISABLE_RUNTIME_OUTBOX_WORKER=

# DEV ONLY
NODE_ENV=development
API_NAME=Starway Backend
PORT=3001
APP_MODE=LM_ONLY
DEFAULT_AI_EXPERT_ID=1

# INTEGRATIONS
SENDPULSE_API_URL=https://api.sendpulse.com
SENDPULSE_API_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
HEYGEN_API_KEY=
HEYGEN_AVATAR_IMAGE_PATH=./avatar.png
OUTPUT_DIR=./output
SCRIPTS_FILE=./reelsScripts.txt
FFMPEG_PATH=/usr/bin/ffmpeg
INSTAGRAM_API_KEY=
WAYFORPAY_MERCHANT_DOMAIN=overrational-unimprisonable-annabella.ngrok-free.dev
