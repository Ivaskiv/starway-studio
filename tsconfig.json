{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "rootDir": ".",
    "baseUrl": ".",
  
    "paths": {
      "@shared/*": ["packages/shared/*"],
      "@backend/*": ["packages/backend/src/*"],
      "@frontend/*": ["packages/frontend/src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  
  "include": ["packages/**/*"],
  "exclude": ["node_modules"]
}
