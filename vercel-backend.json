{
  "version": 2,
  "name": "starway-backend",
  "builds": [
    {
      "src": "packages/backend/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["packages/backend/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "packages/backend/src/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "packages/backend/src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "packages/backend/src/index.ts"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"]
}