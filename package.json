{
  "name": "starway-studio",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
      "dev": "pnpm --filter @starway/backend dev & pnpm --filter @starway/frontend dev",
    "dev:frontend": "pnpm run dev --workspace=packages/frontend",
    "dev:backend": "pnpm run dev --workspace=packages/backend",
    "build:frontend": "pnpm run build --workspace=packages/frontend",
    "build:backend": "pnpm run build --workspace=packages/backend",
    "start:backend": "node packages/backend/dist/index.js",
    "build": "pnpm -r build",
    "lint": "eslint ."
  }
}