{
  "name": "starway-studio",
  "version": "1.0.0",
  "private": true,
  "description": "starway-studio Studio - AI-powered funnel builder",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "dev:frontend": "pnpm --filter @starway/frontend dev",
    "dev:backend": "pnpm --filter @starway/backend dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "build:frontend": "pnpm --filter @starway/frontend build",
    "build:backend": "pnpm --filter @starway/backend build",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/.next packages/*/dist .turbo pnpm-lock.yaml",
    "install:all": "pnpm install"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.3",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@reduxjs/toolkit": "^2.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "morgan": "^1.10.0",
    "openai": "^6.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.68.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.3",
    "reactflow": "^11.11.4",
    "redux-persist": "^6.x.x",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.2.7",
    "zod": "^4.2.1",
    "zustand": "^5.0.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}